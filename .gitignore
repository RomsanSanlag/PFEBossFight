# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*
!Binaries/Win64
Binaries/Win64/*
!Binaries/Win64/PFEBossFight.target
!Binaries/Win64/UnrealEditor.modules
!Binaries/Win64/UnrealEditor-PFEBossFight.dll

# Builds
Build/*
.idea/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# ---------------------------------------------
# Wwise-specific rules
# ---------------------------------------------

# Keep the Wwise plugin and project
!Plugins/Wwise/
!Plugins/Wwise/**

# Keep the Wwise project and soundbanks
!WwiseProject/
!WwiseProject/**
!WwiseProject/GeneratedSoundBanks/**

# But ignore local Wwise user caches and temp files
WwiseProject/.cache/
WwiseProject/.vs/
WwiseProject/*.bak
WwiseProject/Temp/
WwiseProject/.userprefs
WwiseProject/Backup/**
# ---------------------------------------------

# ---------------------------------------------
# KawaiiPhysics_5_5_v1.19.1 a garder avec ses DLL
# ---------------------------------------------

# Ne pas ignorer ce plugin (code, .uplugin, etc.)
!Plugins/KawaiiPhysics_5_5_v1.19.1/
!Plugins/KawaiiPhysics_5_5_v1.19.1/**

# Mais on continue d'ignorer son dossier Intermediate
Plugins/KawaiiPhysics_5_5_v1.19.1/Intermediate/
Plugins/KawaiiPhysics_5_5_v1.19.1/Intermediate/**

# On s'assure que ses Binaries (et donc ses .dll) ne sont PAS ignores
!Plugins/KawaiiPhysics_5_5_v1.19.1/Binaries/
!Plugins/KawaiiPhysics_5_5_v1.19.1/Binaries/**
!Plugins/KawaiiPhysics_5_5_v1.19.1/Binaries/Win64/*.dll